  "figures": [
    {
      "id": "01_study_design",
      "title": "Study design and model recipes",
      "caption": "The completed original-label experiment compares six methods across three seeds. The crop method changes training sampling; all methods use a single full-board pass during common evaluation. Module indicators describe recipe differences and are not an isolated module ablation.",
      "scope": "Completed original-label study. R3-corrected training and original_top2_20261105 Exp7 jobs are excluded.",
      "png": "paper/figures/meeting_20261106/01_study_design.png",
      "svg": "paper/figures/meeting_20261106/01_study_design.svg"
    },
    {
      "id": "02_dataset_examples_counts",
      "title": "Dataset examples and annotation counts",
      "caption": "Four canonical component categories and original-export instance counts. Illustrative crops are the first test annotations, in recorded order, with a short side of at least eight pixels; they were not selected using detector performance. Existing original labels are preserved.",
      "scope": "Original-label RF100 version 3 exports. Total: 543 train / 77 validation / 41 test images. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/02_dataset_examples_counts.png",
      "svg": "paper/figures/meeting_20261106/02_dataset_examples_counts.svg"
    },
    {
      "id": "03_primary_accuracy",
      "title": "Shared-protocol test accuracy",
      "caption": "Mean and sample SD across seeds 0/1/2 on the 41-image original-label test split. Hollow markers show individual seeds. Each model is evaluated with the same common scorer and full-board input, including the crop-trained method. No significance claim is made from three seeds.",
      "scope": "Original-label test \u00b7 square 640 \u00b7 FP32 \u00b7 conf floor 0.001 \u00b7 maxDet 1000 \u00b7 common AP101. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/03_primary_accuracy.png",
      "svg": "paper/figures/meeting_20261106/03_primary_accuracy.svg"
    },
    {
      "id": "04_class_and_operating_metrics",
      "title": "Per-class AP and operating metrics",
      "caption": "AP is averaged over three seeds. Pooled precision and recall are computed by summing class TP/FP/FN at confidence 0.25 and IoU 0.50 within each seed, then summarizing across seeds. They are not best-F1-threshold or macro-averaged P/R. The test split contains only 18 electrolytic annotations.",
      "scope": "Original-label common test protocol \u00b7 three seeds \u00b7 AP50 uses all predictions above the 0.001 input floor. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/04_class_and_operating_metrics.png",
      "svg": "paper/figures/meeting_20261106/04_class_and_operating_metrics.svg"
    },
    {
      "id": "05_precision_recall",
      "title": "Class-specific precision\u2013recall curves",
      "caption": "Seed-0 test PR precision envelopes from frozen common-profile predictions, using the pinned scorer's class-aware IoU matching and AP101 endpoint convention. Parenthesized values are this seed's class AP50, independently reproduced against saved metrics. These curves are not three-seed means.",
      "scope": "Original-label test \u00b7 seed 0 diagnostics \u00b7 full-board prediction \u00b7 same thresholds and caps for all methods. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/05_precision_recall.png",
      "svg": "paper/figures/meeting_20261106/05_precision_recall.svg"
    },
    {
      "id": "06_confusion_matrices",
      "title": "Diagnostic confusion matrices",
      "caption": "Greedy one-to-one class-agnostic IoU matching at IoU 0.50 and confidence 0.25. Rows denote predicted classes; columns denote annotation classes. Background row counts missed annotations; background column counts unmatched detections. Each column is normalized separately, so the background column is an FP composition, not recall. Raw counts are exported. This matrix is not the class-aware operating-metric matcher.",
      "scope": "Original-label common predictions \u00b7 seed 0 \u00b7 true class denominators include only 18 electrolytic boxes. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/06_confusion_matrices.png",
      "svg": "paper/figures/meeting_20261106/06_confusion_matrices.svg"
    },
    {
      "id": "07_detection_comparison",
      "title": "Full-board detection comparisons",
      "caption": "Two predeclared filename groups (Arty_Top and pcb125rec1), using the first export in frozen record order. Columns show original annotations and seed-0 predictions; only predictions with confidence at least 0.25 are displayed. Colors encode class, not correctness. Same image, crop and display threshold are used in every column. Unannotated detections are not automatically false positives because source labels may be incomplete.",
      "scope": "Original-label 640 test illustrations \u00b7 cached predictions \u00b7 images selected independently of detector scores. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/07_detection_comparison.png",
      "svg": "paper/figures/meeting_20261106/07_detection_comparison.svg"
    },
    {
      "id": "08_small_component_zoom",
      "title": "Small-component comparison with fixed zoom",
      "caption": "The same Arty_Top export as Figure 7, with ROI (0, 0, 256, 256). The region maximizes annotated capacitor centers over a fixed 256-pixel window grid; detector performance is not used for selection. Red outlines indicate the shared ROI. Enlarged display does not add image resolution. Prediction confidence is at least 0.25; boxes are cached seed-0 outputs rather than manually redrawn detections.",
      "scope": "Original-label seed-0 diagnostic \u00b7 ROI selected from annotation density \u00b7 fixed region across methods. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/08_small_component_zoom.png",
      "svg": "paper/figures/meeting_20261106/08_small_component_zoom.svg"
    },
    {
      "id": "09_training_dynamics",
      "title": "Completed training dynamics",
      "caption": "Mean validation mAP50 and box-loss traces from the actual completed CSV logs, seeds 0/1/2. Full-board methods use 100 epochs and mixed-crop training 50; the x-axis is normalized scheduled budget, not an equal epoch count. Training-time rectangular/batched validation differs from the common square batch-one final evaluator. Different box-loss definitions mean their absolute loss magnitudes are not directly comparable.",
      "scope": "Completed original-label training histories \u00b7 three seeds \u00b7 no smoothing or fabricated r3 curves.",
      "png": "paper/figures/meeting_20261106/09_training_dynamics.png",
      "svg": "paper/figures/meeting_20261106/09_training_dynamics.svg"
    },
    {
      "id": "10_accuracy_speed_parameters",
      "title": "Accuracy, latency and model size",
      "caption": "The same 18 checkpoints used in the primary accuracy comparison were independently benchmarked on an isolated NVIDIA H100 80GB, FP32, square 640 and batch one. Thirty warmups and 100 timed predictions per checkpoint; latency includes preprocessing, detector and postprocessing, excluding disk decoding/model loading. Error bars are SD across the three checkpoint means. Counts are stored unfused parameters, not FLOPs.",
      "scope": "Shared original-label accuracy \u00b7 isolated H100 FP32 timing \u00b7 no speed comparison with the paper's Apple M4. Inherited split; no board-disjoint generalization claim.",
      "png": "paper/figures/meeting_20261106/10_accuracy_speed_parameters.png",
      "svg": "paper/figures/meeting_20261106/10_accuracy_speed_parameters.svg"
    },
    {
      "id": "11_legacy_ensembles",
      "title": "Exploratory native-resolution ensemble audit",
      "caption": "Four fixed checkpoints and two fixed WBF combinations on the original 44-export legacy test split, square 1280 and FP32. WBF weights are 1.3/1.2 and 1.3/1.2/1.1/1.0, merge IoU 0.50. No new ensemble tuning occurs. These are selected checkpoints with different training recipes. Later review confirmed cross-split photograph overlap and label defects; the scores are exploratory and not certified generalization results.",
      "scope": "EXPLORATORY LEGACY DATA \u00b7 44 exports, not 44 independent boards \u00b7 r3 corrections were not applied to these scores.",
      "png": "paper/figures/meeting_20261106/11_legacy_ensembles.png",
      "svg": "paper/figures/meeting_20261106/11_legacy_ensembles.svg"
    },
    {
      "id": "12_legacy_loss_comparison",
      "title": "Historical three-seed loss comparison",
      "caption": "Related YOLO26s loss recipes from the completed no-extra-online-augmentation native study, mean \u00b1 sample SD over seeds 0/1/2. Squared-Dice smoothing is 0.01. This study used rectangular batch-8 FP32 evaluation, not the selected-champion square batch-one audit. All 21 results, including seven methods and negative comparisons, remain in the source summary; this panel selects the four related YOLO26s loss recipes by architecture rather than score. Shared legacy split/annotation limitations remain.",
      "scope": "EXPLORATORY LEGACY ABLATION \u00b7 original native labels \u00b7 rect=True, batch 8 \u00b7 separate from Figures 3\u201310.",
      "png": "paper/figures/meeting_20261106/12_legacy_loss_comparison.png",
      "svg": "paper/figures/meeting_20261106/12_legacy_loss_comparison.svg"
    },
    {
      "id": "13_annotation_corrections",
      "title": "Traced annotation correction examples",
      "caption": "Top: an existing class-0 annotation changed to class 2, retaining its coordinates. Bottom: four clearly identifiable capacitors that lacked source boxes. These are traced label edits, not model predictions. The full review records 1,758 class changes, 95 additions and 25 deletions across 212 exports. Those totals include transformed/resized variants, not independent objects. R3 component-level review is incomplete; no new training accuracy is inferred from this illustration.",
      "scope": "DATA-QUALITY REVIEW ONLY \u00b7 original files preserved \u00b7 no r3 accuracy in this snapshot \u00b7 no model improvement claimed.",
      "png": "paper/figures/meeting_20261106/13_annotation_corrections.png",
      "svg": "paper/figures/meeting_20261106/13_annotation_corrections.svg"
    },
    {
      "id": "14_published_context",
      "title": "Published context with explicit comparability limits",
      "caption": "Published values are author-reported from Zhou and Agaian, Information 2026, 17, 322, doi:10.3390/info17040322, Tables 4 and 9. Our results use the available original-label RF100 exports and a frozen shared evaluator. Exact author image/annotation identities and table-specific evaluation settings remain unresolved. No cross-block improvement, ranking or speedup claim is justified.",
      "scope": "CONTEXT ONLY across the two blocks. Quantitative improvement claims use our own identically evaluated controls.",
      "png": "paper/figures/meeting_20261106/14_published_context.png",
      "svg": "paper/figures/meeting_20261106/14_published_context.svg"
    },
    {
      "id": "15_native_master_metrics",
      "title": "Exact native champion and ensemble metrics",
      "caption": "All six completed legacy configurations under the same square-1280 batch-one FP32 audit. P/R/F1 pool counts at confidence 0.25 and matching IoU 0.50; AP uses all saved predictions. Latency includes preprocessing, detector, postprocessing and WBF fusion; FPS is 1,000 divided by mean latency. Parameters sum the stored unfused member checkpoints. Class AP values include the legacy electrolytic category with only 18 annotations. Known cross-split photographs and labeling defects preclude a final independent-generalization claim.",
      "scope": "EXPLORATORY LEGACY AUDIT \u00b7 exact checkpoint hashes \u00b7 no mixing with original-label or corrected-r3 metrics.",
      "png": "paper/figures/meeting_20261106/15_native_master_metrics.png",
      "svg": "paper/figures/meeting_20261106/15_native_master_metrics.svg"
    },
    {
      "id": "16_native_ensemble_detections",
      "title": "Legacy single-model and WBF detections",
      "caption": "One predeclared Arty_Top legacy export and its annotation-density-selected zoom. Predictions are exactly the cached audit outputs, with confidence at least 0.25 for display. WBF confidence rescaling is preserved; equal numeric confidence does not imply identical score calibration across pipelines. Original image/label hashes and all three caches were checked, and their class AP50 and operating TP/FP counts independently reproduced. Colors denote class, not correctness. Native split overlap and annotation limitations remain.",
      "scope": "EXPLORATORY LEGACY DATA \u00b7 selected checkpoint audit \u00b7 full board and same zoom \u00b7 no new inference or retuning.",
      "png": "paper/figures/meeting_20261106/16_native_ensemble_detections.png",
      "svg": "paper/figures/meeting_20261106/16_native_ensemble_detections.svg"
