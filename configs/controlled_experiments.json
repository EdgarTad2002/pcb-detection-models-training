{
  "version": "controlled_v1",
  "ultralytics_version": "8.4.126",
  "seeds": [0, 1, 2],
  "datasets": {
    "clean": "datasets/pcb-native-res-cleaned-1280/data.yaml",
    "cappaste": "datasets/pcb-native-res-cleaned-cappaste-1280/data.yaml",
    "mixed": "datasets/pcb-native-mixed-crops-controlled-v1/data.yaml"
  },
  "evaluation_dataset": "clean",
  "reference_epochs": 100,
  "reference_dataset": "clean",
  "crop_inference": {"slice_size": 640, "imgsz": 1280, "overlap": 0.2},
  "common": {
    "imgsz": 1280, "batch": 8, "nbs": 8, "workers": 8,
    "optimizer": "SGD", "lr0": 0.01, "lrf": 0.01,
    "momentum": 0.937, "weight_decay": 0.0005, "warmup_epochs": 3.0,
    "patience": 0, "no_cache": true,
    "box": 7.5, "cls": 0.5, "dfl": 1.5,
    "copy_paste": 0.0, "mixup": 0.0, "mosaic": 0.0, "close_mosaic": 0,
    "degrees": 0.0, "translate": 0.1, "scale": 0.5,
    "shear": 0.0, "perspective": 0.0,
    "hsv_h": 0.015, "hsv_s": 0.7, "hsv_v": 0.4,
    "fliplr": 0.5, "flipud": 0.0,
    "max_det": 1000, "eval_conf": 0.001, "eval_iou": 0.5
  },
  "models": {
    "yolov5s": {"weights": "yolov5su.pt"},
    "yolov8s": {"weights": "yolov8s.pt"},
    "yolov9s": {"weights": "yolov9s.pt"},
    "yolov10s": {"weights": "yolov10s.pt"},
    "yolo11s": {"weights": "yolo11s.pt"},
    "yolov12s": {"weights": "yolo12s.pt"},
    "yolo26s": {"weights": "yolo26s.pt"},
    "yolo26s_p2": {"weights": "yolo26s-p2.yaml", "pretrained_weights": "yolo26s.pt"},
    "yolo26s_nwd": {"weights": "yolo26s.pt", "nwd_loss": true},
    "yolo26s_agwd": {"weights": "yolo26s.pt", "agwd_ota": true},
    "yolo26s_sdice": {"weights": "yolo26s.pt", "squared_dice": true, "lambda_dice": 0.5, "smooth_dice": 0.01},
    "yolo26s_agwd_sdice": {"weights": "yolo26s.pt", "agwd_ota": true, "squared_dice": true, "lambda_dice": 0.5, "smooth_dice": 0.01},
    "yolo26s_agwd_sdice_l035": {"weights": "yolo26s.pt", "agwd_ota": true, "squared_dice": true, "lambda_dice": 0.35, "smooth_dice": 0.01},
    "yolo26s_icm": {"weights": "yolo26s.pt", "use_icm": true, "agwd_ota": true, "squared_dice": true, "lambda_dice": 0.5, "smooth_dice": 0.01},
    "yolo26s_retinex": {"weights": "yolo26s.pt", "retinex_stem": true},
    "yolo26s_weber": {"weights": "yolo26s.pt", "weber_stem": true},
    "yolo26s_igr": {"weights": "yolo26s.pt", "use_igr_stem": true},
    "yolo26s_fgcsfa": {"weights": "yolo26s.pt", "use_fg_csfa": true},
    "yolo26s_acasupcon": {"weights": "yolo26s.pt", "use_aca_supcon": true},
    "physot_yolo26s": {"weights": "yolo26s.pt", "agwd_ota": true, "use_igr_stem": true, "use_fg_csfa": true, "use_aca_supcon": true},
    "superyolo26s": {"weights": "yolo26s.pt", "architecture": "superyolo", "lambda_sr": 0.1},
    "spectral_yolo26s": {"weights": "yolo26s.pt", "architecture": "spectral", "spectral_alpha": 0.25}
  },
  "studies": {
    "main": {
      "dataset": "cappaste", "epochs": 100,
      "models": ["yolov5s", "yolov8s", "yolov9s", "yolov10s", "yolo11s", "yolov12s", "yolo26s", "yolo26s_p2", "yolo26s_nwd", "yolo26s_agwd", "yolo26s_sdice", "yolo26s_agwd_sdice", "yolo26s_agwd_sdice_l035", "yolo26s_icm", "yolo26s_retinex", "yolo26s_weber", "yolo26s_igr", "yolo26s_fgcsfa", "yolo26s_acasupcon", "physot_yolo26s", "superyolo26s", "spectral_yolo26s"]
    },
    "augmentation": {"models": ["yolo26s_agwd_sdice"], "datasets": ["clean", "cappaste"], "match_budget": true},
    "crop": {"models": ["yolo26s_agwd_sdice"], "datasets": ["clean", "mixed"], "match_budget": true}
  }
}
