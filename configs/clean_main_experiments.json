{
  "version": "clean_main_noextraaug_v1",
  "ultralytics_version": "8.4.126",
  "seeds": [
    0,
    1,
    2
  ],
  "datasets": {
    "clean": "datasets/pcb-native-res-cleaned-1280/data.yaml"
  },
  "evaluation_dataset": "clean",
  "reference_epochs": 100,
  "reference_dataset": "clean",
  "common": {
    "imgsz": 1280,
    "batch": 8,
    "nbs": 8,
    "workers": 8,
    "optimizer": "SGD",
    "lr0": 0.01,
    "lrf": 0.01,
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "warmup_epochs": 3.0,
    "patience": 0,
    "no_cache": true,
    "box": 7.5,
    "cls": 0.5,
    "dfl": 1.5,
    "copy_paste": 0.0,
    "mixup": 0.0,
    "mosaic": 0.0,
    "close_mosaic": 0,
    "degrees": 0.0,
    "translate": 0.0,
    "scale": 0.0,
    "shear": 0.0,
    "perspective": 0.0,
    "hsv_h": 0.0,
    "hsv_s": 0.0,
    "hsv_v": 0.0,
    "fliplr": 0.0,
    "flipud": 0.0,
    "max_det": 1000,
    "eval_conf": 0.001,
    "eval_iou": 0.5
  },
  "models": {
    "yolov10s": {
      "weights": "yolov10s.pt"
    },
    "yolov12s": {
      "weights": "yolo12s.pt"
    },
    "yolo26s": {
      "weights": "yolo26s.pt"
    },
    "yolo26s_sdice": {
      "weights": "yolo26s.pt",
      "squared_dice": true,
      "lambda_dice": 0.5,
      "smooth_dice": 0.01
    },
    "yolo26s_agwd_sdice": {
      "weights": "yolo26s.pt",
      "agwd_ota": true,
      "squared_dice": true,
      "lambda_dice": 0.5,
      "smooth_dice": 0.01
    },
    "yolo26s_agwd_sdice_l035": {
      "weights": "yolo26s.pt",
      "agwd_ota": true,
      "squared_dice": true,
      "lambda_dice": 0.35,
      "smooth_dice": 0.01
    },
    "physot_yolo26s": {
      "weights": "yolo26s.pt",
      "agwd_ota": true,
      "use_igr_stem": true,
      "use_fg_csfa": true,
      "use_aca_supcon": true
    }
  },
  "studies": {
    "main": {
      "dataset": "clean",
      "epochs": 100,
      "models": [
        "yolov10s",
        "yolov12s",
        "yolo26s",
        "yolo26s_sdice",
        "yolo26s_agwd_sdice",
        "yolo26s_agwd_sdice_l035",
        "physot_yolo26s"
      ]
    }
  }
}
