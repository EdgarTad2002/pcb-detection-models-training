{
  "version": "info17_1280_v1",
  "ultralytics_version": "8.4.126",
  "seeds": [0],
  "datasets": {
    "paper": "datasets/info17-original-fourclass-v1/data.yaml",
    "mixed": "datasets/info17-original-mixed-crops-v1/data.yaml"
  },
  "evaluation_dataset": "paper",
  "reference_dataset": "paper",
  "reference_epochs": 100,
  "common": {
    "imgsz": 1280, "batch": 8, "nbs": 8, "workers": 0,
    "optimizer": "SGD", "lr0": 0.01, "lrf": 0.01,
    "momentum": 0.937, "weight_decay": 0.0005, "warmup_epochs": 3.0,
    "patience": 0, "no_cache": true,
    "box": 7.5, "cls": 0.5, "dfl": 1.5,
    "copy_paste": 0.0, "mixup": 0.0, "mosaic": 1.0, "close_mosaic": 10,
    "degrees": 0.0, "translate": 0.1, "scale": 0.5,
    "shear": 0.0, "perspective": 0.0,
    "hsv_h": 0.015, "hsv_s": 0.7, "hsv_v": 0.4,
    "fliplr": 0.5, "flipud": 0.0,
    "max_det": 1000, "eval_conf": 0.001, "eval_iou": 0.5
  },
  "models": {
    "yolov12s": {"weights": "yolo12s.pt"},
    "yolo26s_agwd_sdice": {
      "weights": "yolo26s.pt", "agwd_ota": true,
      "agwd_kappa": 12.8, "agwd_tau": 576.0, "agwd_alpha_kld": 0.25, "tal_beta": 3.0,
      "squared_dice": true, "lambda_dice": 0.5, "smooth_dice": 0.01
    },
    "yolo26s_crop_specialist": {
      "weights": "yolo26s.pt", "agwd_ota": true,
      "agwd_kappa": 12.8, "agwd_tau": 576.0, "agwd_alpha_kld": 0.25, "tal_beta": 3.0,
      "squared_dice": true, "lambda_dice": 0.5, "smooth_dice": 0.01,
      "close_mosaic": 5
    },
    "yolov9s": {"weights": "yolov9s.pt"},
    "physot_yolo26s": {
      "weights": "yolo26s.pt", "agwd_ota": true,
      "agwd_kappa": 12.8, "agwd_tau": 576.0, "agwd_alpha_kld": 0.25, "tal_beta": 3.0,
      "use_igr_stem": true, "use_fg_csfa": true, "use_aca_supcon": true
    },
    "yolov8s": {"weights": "yolov8s.pt"}
  },
  "studies": {
    "main": {
      "dataset": "paper", "epochs": 100,
      "models": ["yolov12s", "yolo26s_agwd_sdice", "yolov9s", "physot_yolo26s", "yolov8s"]
    },
    "crop": {
      "datasets": ["mixed"], "match_budget": true,
      "models": ["yolo26s_crop_specialist"]
    }
  }
}
